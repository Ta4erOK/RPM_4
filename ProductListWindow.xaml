<Window x:Class="Lab3.ProductListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab3"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        Title="Список товаров" Height="450" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="boolToVisibility"/>
    </Window.Resources>

    <d:Window.DataContext>
        <local:ProductListWindow/>
    </d:Window.DataContext>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="10" VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <TextBlock Margin="25,0"
                       VerticalAlignment="Center"
                       Text="{Binding User.FullName, FallbackValue='Гость'}" />
            <Button Padding="3" Content="Выход" Click="ExitButtonClick"/>
        </StackPanel>

        <Expander Header="Средства поиска"
                  IsExpanded="False"
                  DockPanel.Dock="Top"
                  Visibility="{Binding CanFilterProducts, Converter={StaticResource boolToVisibility}}">
            <StackPanel Margin="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchTextBox" Width="260"
                             TextChanged="SearchTextBoxTextChanged"/>
                </StackPanel>
                <TextBlock Text="Ищет по артикулу, названию, категории, описанию, производителю и поставщику. Можно несколько слов через пробел."
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Expander>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
            <ItemsControl ItemsSource="{Binding ProductsView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:SingleProductView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>